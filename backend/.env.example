# Copy to .env and adjust as needed
# FRONTEND_ORIGIN: địa chỉ website (app Next :3000); nhiều địa chỉ cách nhau bằng dấu phẩy
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Seeds the first MAIN_ADMIN account (see prisma/seed.js). Change the
# password before running the seed against a real database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs login JWTs. Use a long random string in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=change-me-to-a-random-string

# Postgres connection string (Supabase: Settings -> Database -> Connection
# string -> URI). Used for Orders / Shipping (Prisma).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# =====================================================================
# KHI DEPLOY: sửa các biến dưới đây (khi chạy trên máy cá nhân có thể để trống)
# =====================================================================

# Địa chỉ web của khách (có thể nhiều địa chỉ, cách nhau dấu phẩy). Ví dụ:
# FRONTEND_ORIGIN=https://clevinum.vn,https://www.clevinum.vn
# (đã khai báo ở đầu file: nhớ đổi sang địa chỉ thật khi deploy)

# Nếu backend nằm sau proxy/nginx/Render/Railway... đặt =1 để giới hạn tần suất (chống đoán mật khẩu)
# nhìn thấy IP thật của khách thay vì IP của proxy.
TRUST_PROXY=

# ---- Tự động xác nhận thanh toán chuyển khoản (SePay hoặc Casso) ----
# Hệ thống tìm MÃ ĐƠN (ORD-xxxxx) trong nội dung chuyển khoản và so số tiền. Đủ tiền thì tự chuyển đơn sang
# "Đã thanh toán"; thiếu tiền / sai mã đơn thì KHÔNG tự xác nhận mà báo ở mục Thanh toán để bạn kiểm tra.
# Để trống = tắt (bạn vẫn xác nhận bằng tay ở mục Thanh toán).
#
# Cách bật SePay:
#   1. Điền SEPAY_WEBHOOK_API_KEY bên dưới bằng một chuỗi ngẫu nhiên dài (tự đặt).
#   2. Trong SePay: tạo Webhook, URL:  https://<tên-miền-backend>/api/payments/webhook/sepay
#      Kiểu chứng thực: "API Key", điền đúng chuỗi ở bước 1. Chỉ gửi giao dịch tiền VÀO (in).
SEPAY_WEBHOOK_API_KEY=
#
# Cách bật Casso:
#   1. Điền CASSO_WEBHOOK_SECRET bằng "Khóa bảo mật" (Security key) bạn đặt khi tạo webhook ở Casso.
#   2. Trong Casso: URL webhook:  https://<tên-miền-backend>/api/payments/webhook/casso
#   3. Tên header chứa khóa: mặc định "secure-token". Tài liệu Casso không ghi rõ tên này, nên hãy kiểm tra
#      lại trong tài liệu / thử gửi giao dịch mẫu; nếu khác thì sửa CASSO_WEBHOOK_HEADER.
CASSO_WEBHOOK_SECRET=
CASSO_WEBHOOK_HEADER=secure-token
#
# Lưu ý: webhook phải là địa chỉ HTTPS công khai. Chạy trên máy cá nhân thì dùng đường hầm (ngrok...) để thử.
# Số tài khoản nhận tiền khai báo ở trang quản trị: Cài đặt > Thanh toán (giao dịch về tài khoản khác sẽ bị bỏ qua).

# ---- Bảo mật khi deploy ----
# NODE_ENV=production : bật chế độ chạy thật (ẩn chi tiết lỗi, ép JWT_SECRET >= 32 ký tự).
# FORCE_HTTPS=1       : chuyển http -> https (cần TRUST_PROXY để đọc đúng giao thức sau proxy/CDN).
# BACKUP_KEEP=14      : số bản sao lưu giữ lại khi chạy `npm run backup`.

# ---- Gửi email (xác nhận đơn, đổi trạng thái đơn, quên mật khẩu) ----
# Chưa điền SMTP_HOST thì hệ thống KHÔNG gửi mà in nội dung email ra log máy chủ (tiện chạy thử).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<mật khẩu ứng dụng 16 ký tự>
# (Google Account > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng). Hoặc dùng Resend / SendGrid / Brevo (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLEVINUM <no-reply@ten-mien-cua-ban.vn>"
# Địa chỉ website khách, dùng trong link của email (theo dõi đơn, đặt lại mật khẩu).
SHOP_URL=http://localhost:3000

# ---- Đăng nhập bằng Google ----
# Tạo "OAuth client ID" loại Web ở https://console.cloud.google.com/apis/credentials, thêm địa chỉ website vào "Authorized JavaScript origins".
# Dùng CÙNG một Client ID cho backend (GOOGLE_CLIENT_ID) và frontend (VITE_GOOGLE_CLIENT_ID). Để trống thì nút Google bị ẩn.
GOOGLE_CLIENT_ID=

# ---- Thanh toán online qua PayOS (tùy chọn) ----
# Đăng ký ở https://payos.vn > tạo Kênh thanh toán (cần liên kết tài khoản ngân hàng nhận tiền) > lấy 3 khóa dưới đây.
# Điền đủ 3 khóa thì trang thanh toán tự hiện thêm "Thanh toán online (PayOS)". Để trống thì ẩn.
# Webhook: trong PayOS đặt Webhook URL = https://<tên-miền-backend>/api/payments/webhook/payos (phải là HTTPS công khai).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
