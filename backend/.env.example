# Copy to .env and adjust as needed
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Seeds the first MAIN_ADMIN account (see prisma/seed.js). Change the
# password before running the seed against a real database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs login JWTs. Use a long random string in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=change-me-to-a-random-string

# Postgres connection string (Supabase: Settings -> Database -> Connection
# string -> URI). Used for Orders / Shipping (Prisma).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
