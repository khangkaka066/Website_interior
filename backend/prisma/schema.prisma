// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts / roles
// ---------------------------------------------------------------------------

enum AccountRole {
  CUSTOMER
  ADMIN
}

enum AdminRole {
  MAIN_ADMIN
  SUPPORT_ADMIN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         AccountRole @default(CUSTOMER)
  // Only set when role = ADMIN.
  adminRole    AdminRole?

  // Links a CUSTOMER-role account to its CRM record (orders, addresses...).
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Mã đặt lại mật khẩu: chỉ lưu bản băm (SHA-256) của mã gửi qua email, dùng một lần, hết hạn sau 1 giờ.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per manageable feature area. SUPPORT_ADMIN accounts can use a
// feature only if its row is enabled here; MAIN_ADMIN always has full
// access regardless of these rows and can flip them from the admin UI.
model SupportPermission {
  key               String   @id
  label             String
  enabledForSupport Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  phone     String         @unique
  email     String?        @unique
  dob       DateTime?
  gender    String?
  avatarUrl String?
  status    CustomerStatus @default(ACTIVE)
  tags      String[]       @default([])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  orders        Order[]
  addresses     CustomerAddress[]
  notes         CustomerNote[]
  conversations Conversation[]
  account       User?

  @@index([email])
  @@index([status])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  addressLine   String
  ward          String?
  district      String?
  province      String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  author     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_CONFIRMATION // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  PROCESSING // Đang xử lý
  AWAITING_SHIPMENT // Chờ giao hàng
  SHIPPING // Đang giao
  DELIVERED // Đã giao
  CANCELLED // Đã hủy
  RETURNED // Đã trả hàng
}

enum PaymentStatus {
  AWAITING_PAYMENT // Chờ thanh toán
  PAID // Đã thanh toán
  FAILED // Thanh toán thất bại
  REFUNDED // Đã hoàn tiền
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // e.g. ORD-10293
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(PENDING_CONFIRMATION)
  paymentStatus PaymentStatus @default(AWAITING_PAYMENT)
  paymentMethod String
  transactionId String?
  // Khách yêu cầu hủy khi shop đã xác nhận (chờ nhân viên duyệt) / lý do bị từ chối. receivedAt: khách bấm "Đã nhận hàng" hoặc hệ thống tự xác nhận.
  cancelRequestedAt   DateTime?
  cancelRequestReason String?
  cancelRejectedNote  String?
  receivedAt          DateTime?
  // Cách giao: EXPRESS (hỏa tốc) | INTRACITY (nội thành) | INTERPROVINCE (liên tỉnh), chốt lúc đặt hàng; shippingService: dịch vụ vận chuyển khách đã chọn.
  deliveryType        String?
  shippingService     String?
  // Hãng vận chuyển khách đã chọn lúc đặt hàng (để lúc chuẩn bị hàng dùng lại đúng hãng); packedAt/packedBy: đã đóng gói (quét mã vạch trên tem).
  shippingCarrier     String?
  packedAt            DateTime?
  packedBy            String?
  // Tọa độ điểm giao (tự tìm từ địa chỉ, nhân viên sửa được): chỉ cần cho đơn hỏa tốc qua Goship (API hỏa tốc dùng tọa độ chứ không dùng mã tỉnh/quận/phường).
  recipientLat        Float?
  recipientLng        Float?
  // Tồn kho đã được trừ cho đơn này (đơn tạo trước khi có tính năng trừ kho thì false, để hủy đơn không cộng lại nhầm).
  stockReserved Boolean       @default(false)

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  couponCode  String? // mã giảm giá khách đã dùng (số tiền giảm nằm ở discount)

  // Shipping address (snapshot at time of order)
  recipientName String
  recipientPhone String
  addressLine   String
  ward          String?
  district      String?
  province      String

  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  shipment      Shipment?
  returnRequest ReturnRequest?
  activityLogs  ActivityLog[]

  // Marketing attribution — set when the order was placed through the
  // storefront checkout with UTM params (or a matching internal Campaign)
  // present in that session.
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([campaignId])
  @@index([deliveryType])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  name       String
  sku        String?
  variant    String?
  image      String?
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  review     Review?

  @@index([orderId])
}

enum ReturnRequestStatus {
  REQUESTED // Khách đã gửi, chờ shop duyệt
  APPROVED // Shop đồng ý (đơn chuyển Đã trả hàng)
  REJECTED // Shop từ chối
}

// Yêu cầu trả hàng/hoàn tiền của khách sau khi nhận hàng (mỗi đơn một yêu cầu).
model ReturnRequest {
  id         String              @id @default(cuid())
  orderId    String              @unique
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason     String
  note       String?
  status     ReturnRequestStatus @default(REQUESTED)
  adminNote  String?
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  @@index([status])
}

// Đánh giá sản phẩm của khách đã nhận hàng (mỗi dòng sản phẩm của đơn được đánh giá một lần). hidden: nhân viên ẩn đánh giá không phù hợp.
model Review {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId   String
  rating      Int
  comment     String?
  authorName  String
  variant     String?
  hidden      Boolean   @default(false)
  reply       String? // phản hồi của shop (hiện công khai dưới đánh giá)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([productId, hidden])
}

// Timeline: Đặt hàng -> Đã xác nhận -> Đang xử lý -> Đã đóng gói ->
// Đã bàn giao vận chuyển -> Đang giao -> Đã giao
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Shipping / Shipment
// ---------------------------------------------------------------------------

enum ShippingStatus {
  NOT_CREATED // Chưa tạo vận đơn
  AWAITING_PICKUP // Chờ lấy hàng
  PICKED_UP // Đã lấy hàng
  IN_TRANSIT // Đang trung chuyển
  OUT_FOR_DELIVERY // Đang giao
  DELIVERED // Giao thành công
  FAILED // Giao thất bại
  RETURNING // Đang hoàn
  RETURNED // Đã hoàn
}

model ShippingCarrier {
  id           String   @id @default(cuid())
  code         String   @unique // GHN, GHTK, VIETTELPOST, JT, VNPOST, ...
  name         String
  enabled      Boolean  @default(true)
  apiStatus    String   @default("disconnected") // connected | disconnected | error
  apiConfig    Json? // { apiKey, secret, shopId, ... }
  serviceTypes Json? // ["Giao nhanh", "Giao tiết kiệm", ...]

  shipments Shipment[]
  handovers Handover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id         String @id @default(cuid())
  trackingId String @unique
  // Mã vận đơn của hãng vận chuyển (GHN, GHTK...). Có thì hiển thị thay cho mã đơn ORD-xxxxx (xem lib/orderCode.js).
  carrierCode String?
  // Mã phân loại của hãng (in lớn giữa tem giao hàng để kho hãng chia tuyến). Goship trả về khi tạo vận đơn.
  sortingCode String?
  // Cách giao hàng cho hãng (chọn lúc "Chuẩn bị hàng"): PICKUP = hãng tới shop lấy; DROP_OFF = shop mang ra bưu cục. Goship API không có trường này nên chỉ lưu ở hệ thống mình.
  pickupMethod String?
  // true = vận đơn hỏa tốc (API hỏa tốc của Goship: Ahamove, Grab): mã trạng thái, webhook và cách hủy khác vận đơn thường.
  onDemand Boolean @default(false)
  // Biên bản bàn giao cho hãng chứa vận đơn này (null = chưa bàn giao).
  handoverId String?
  handover   Handover? @relation(fields: [handoverId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  carrierId String
  carrier   ShippingCarrier @relation(fields: [carrierId], references: [id])

  status ShippingStatus @default(NOT_CREATED)

  senderName     String
  recipientName  String
  recipientPhone String
  addressLine    String
  ward           String?
  district       String?
  province       String

  weightGrams Int
  lengthCm    Int?
  widthCm     Int?
  heightCm    Int?
  goodsType   String?

  shippingFee Decimal @db.Decimal(12, 2)
  codAmount   Decimal @default(0) @db.Decimal(12, 2)
  note        String?

  trackingEvents TrackingEvent[]
  activityLogs   ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([carrierId])
  @@index([carrierCode])
  @@index([handoverId])
}

// Timeline: Đã tạo vận đơn -> Đã lấy hàng -> Đã đến kho -> Đang trung chuyển
// -> Đến kho giao hàng -> Đang giao -> Giao thành công
// Biên bản bàn giao: một lần giao nhiều kiện cho một hãng (shipper tới lấy hoặc shop mang ra bưu cục), in ra để hai bên ký.
model Handover {
  id        String          @id @default(cuid())
  code      String          @unique // BG-YYMMDD-xxx
  carrierId String
  carrier   ShippingCarrier @relation(fields: [carrierId], references: [id])
  createdBy String
  createdAt DateTime        @default(now())
  shipments Shipment[]

  @@index([carrierId])
  @@index([createdAt])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Activity log (audit trail for sensitive actions)
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String // "order" | "shipment"
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  action     String // e.g. "confirm_order", "cancel_order", "create_shipment"
  actor      String // admin username
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Live chat (storefront -> admin dashboard)
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  CUSTOMER
  ADMIN
}

model Conversation {
  id            String             @id @default(cuid())
  customerId    String?
  customer      Customer?          @relation(fields: [customerId], references: [id])
  guestName     String
  guestPhone    String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())

  messages Message[]

  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String
  readByAdmin    Boolean       @default(false)
  readByCustomer Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([conversationId])
}

// Câu trả lời nhanh của nhân viên tư vấn trong mục Tin nhắn (dùng chung cho cả đội). {ten} trong text được thay bằng tên khách.
model QuickReply {
  id        String   @id @default(cuid())
  label     String
  text      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Ad campaign management (manual tracking tool — no live Meta/Google/TikTok
// API sync; "platform" is just a classification label the admin sets)
// ---------------------------------------------------------------------------

enum AdPlatform {
  META
  GOOGLE
  TIKTOK
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  platform    AdPlatform
  objective   String
  status      CampaignStatus @default(DRAFT)
  budgetTotal Decimal        @db.Decimal(12, 2)
  budgetDaily Decimal?       @db.Decimal(12, 2)
  spentAmount Decimal        @default(0) @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  // Tracking code used in ?utm_campaign=<utmCode> links so storefront
  // sessions/orders can be attributed back to this campaign.
  utmCode     String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  adSets AdSet[]
  orders Order[]

  @@index([status])
  @@index([platform])
}

model AdSet {
  id               String         @id @default(cuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name             String
  audienceAgeMin   Int?
  audienceAgeMax   Int?
  audienceGender   String? // all | male | female
  audienceLocation String?
  interests        String[]       @default([])
  budget           Decimal        @db.Decimal(12, 2)
  status           CampaignStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  ads Ad[]

  @@index([campaignId])
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
}

model Ad {
  id           String         @id @default(cuid())
  adSetId      String
  adSet        AdSet          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name         String
  creativeType CreativeType   @default(IMAGE)
  headline     String
  bodyCopy     String?
  ctaLabel     String?
  imageUrl     String?
  status       CampaignStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([adSetId])
}

// ---------------------------------------------------------------------------
// Storefront analytics events (real event tracking for funnel/attribution)
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  PAGE_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  sessionId   String
  type        AnalyticsEventType
  path        String?
  productId   String?
  orderId     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime           @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@index([utmCampaign])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

// Sản phẩm do quản trị viên quản lý (nhập Excel, sửa giá...). Các cột rời để lọc/đánh chỉ mục;
// toàn bộ sản phẩm (phân loại, ảnh, mô tả...) nằm nguyên trong `data` đúng như trang quản trị lưu.
model Product {
  id         String   @id
  shopeeId   String?  @unique
  sku        String?
  name       String
  status     String   @default("active")
  categoryId String?
  price      Int      @default(0)
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
}

// Bài viết (mục Tin tức trên website). Nội dung là văn bản thuần: dòng trống tách đoạn, dòng bắt đầu bằng "## " là tiêu đề nhỏ
// (website tự dựng HTML, không nhận HTML từ admin nên không có rủi ro XSS).
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     String    @default("")
  coverUrl    String?
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

// Cài đặt cửa hàng (thông tin shop, thanh toán, phí ship, nội dung trang...). Một dòng key = "shop" chứa toàn bộ cài đặt dạng JSON.
// Lưu trong database (không lưu file) vì ổ đĩa của nơi host như Render bị xóa mỗi lần deploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Mã giảm giá khách nhập ở trang thanh toán. FIXED: giảm số tiền cố định (value = đồng). PERCENT: giảm theo phần trăm (value = %, tối đa maxDiscount đồng).
// minOrder: đơn tối thiểu (tạm tính); usageLimit: tổng lượt dùng (null = không giới hạn); perCustomerLimit: lượt tối đa mỗi khách.
enum CouponType {
  FIXED
  PERCENT
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             CouponType
  value            Int
  maxDiscount      Int?
  minOrder         Int                @default(0)
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean            @default(true)
  redemptions      CouponRedemption[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Mỗi đơn dùng mã ghi một dòng (hủy đơn / trả hàng thì xóa dòng này và trả lại lượt dùng).
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  customerId String
  amount     Int
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
}
