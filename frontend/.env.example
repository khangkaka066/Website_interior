# Copy this file to .env and fill in your own Google OAuth Client ID
# (create one at https://console.cloud.google.com/apis/credentials,
# type "OAuth client ID" -> "Web application", add your dev/prod URL
# to "Authorized JavaScript origins"). Without this, the "Đăng nhập
# bằng Google" button on /login stays disabled.
VITE_GOOGLE_CLIENT_ID=

# URL của backend. ĐỂ TRỐNG khi chạy dev: frontend gọi /api và Vite tự chuyển tới backend :4000 (chạy được cả qua link công khai).
VITE_API_BASE_URL=

# KHI DEPLOY: đổi VITE_API_BASE_URL sang địa chỉ backend thật, ví dụ:
# VITE_API_BASE_URL=https://api.clevinum.vn
# (Biến VITE_* được ghi vào file build, nên đổi xong phải build lại: npm run build)
