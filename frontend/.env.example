# Địa chỉ backend mà máy chủ Next gọi tới và chuyển tiếp /api, /robots.txt, /sitemap.xml sang đó.
BACKEND_URL=http://localhost:4000

# Địa chỉ công khai của website (dùng trong thẻ canonical, Open Graph, dữ liệu có cấu trúc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Để trống: trình duyệt gọi /api cùng địa chỉ và Next chuyển sang backend. Chỉ đặt khi backend nằm ở tên miền khác.
NEXT_PUBLIC_API_BASE_URL=

# Client ID Google (cùng giá trị với GOOGLE_CLIENT_ID của backend). Để trống thì ẩn nút đăng nhập Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
