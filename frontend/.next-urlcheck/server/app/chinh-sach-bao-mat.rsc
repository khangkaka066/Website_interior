8:["$","div",null,{"className":"mt-8 max-w-3xl space-y-8","children":[["$","section","Thông tin chúng tôi thu thập",{"children":[["$","h2",null,{"className":"text-xl font-semibold","children":[1,". ","Thông tin chúng tôi thu thập"]}],"$undefined",["$","ul",null,{"className":"mt-3 list-disc space-y-1.5 pl-6 leading-relaxed","children":[["$","li","Thông tin đặt hàng: họ tên, số điện thoại, email (không bắt buộc), địa chỉ giao hàng.",{"children":"Thông tin đặt hàng: họ tên, số điện thoại, email (không bắt buộc), địa chỉ giao hàng."}],["$","li","Thông tin tài khoản: họ tên, email và mật khẩu (được mã hóa một chiều, chúng tôi không đọc được mật khẩu của bạn). Nếu đăng nhập bằng Google, chúng tôi chỉ nhận họ tên và địa chỉ email đã xác minh từ Google.",{"children":"Thông tin tài khoản: họ tên, email và mật khẩu (được mã hóa một chiều, chúng tôi không đọc được mật khẩu của bạn). Nếu đăng nhập bằng Google, chúng tôi chỉ nhận họ tên và địa chỉ email đã xác minh từ Google."}],["$","li","Dữ liệu sử dụng website: các trang đã xem, nguồn truy cập, nội dung trò chuyện với cửa hàng, nhằm vận hành và cải thiện dịch vụ.",{"children":"Dữ liệu sử dụng website: các trang đã xem, nguồn truy cập, nội dung trò chuyện với cửa hàng, nhằm vận hành và cải thiện dịch vụ."}]]}]]}],["$","section","Mục đích sử dụng",{"children":[["$","h2",null,{"className":"text-xl font-semibold","children":[2,". ","Mục đích sử dụng"]}],"$undefined",["$","ul",null,{"className":"mt-3 list-disc space-y-1.5 pl-6 leading-relaxed","children":[["$","li","Xử lý, giao hàng và chăm sóc đơn hàng; gửi email xác nhận và cập nhật trạng thái đơn.",{"children":"Xử lý, giao hàng và chăm sóc đơn hàng; gửi email xác nhận và cập nhật trạng thái đơn."}],["$","li","Tạo và quản lý tài khoản, hiển thị lịch sử đơn hàng của bạn.",{"children":"Tạo và quản lý tài khoản, hiển thị lịch sử đơn hàng của bạn."}],["$","li","Hỗ trợ khách hàng, giải quyết khiếu nại, bảo hành và đổi trả.",{"children":"Hỗ trợ khách hàng, giải quyết khiếu nại, bảo hành và đổi trả."}],["$","li","Phát hiện gian lận, bảo vệ an toàn cho website và khách hàng.",{"children":"Phát hiện gian lận, bảo vệ an toàn cho website và khách hàng."}]]}]]}],["$","section","Chia sẻ thông tin",{"children":[["$","h2",null,{"className":"text-xl font-semibold","children":[3,". ","Chia sẻ thông tin"]}],[["$","p","Chúng tôi không bán thông tin cá nhân của bạn. Thông tin chỉ được chia sẻ với bên thứ ba khi cần thiết để hoàn tất dịch vụ: đơn vị vận chuyển (để giao hàng), cổng thanh toán hoặc ngân hàng (để xác nhận thanh toán), nhà cung cấp email và hạ tầng lưu trữ, hoặc khi cơ quan nhà nước có thẩm quyền yêu cầu theo quy định pháp luật.",{"className":"mt-3 leading-relaxed","children":"Chúng tôi không bán thông tin cá nhân của bạn. Thông tin chỉ được chia sẻ với bên thứ ba khi cần thiết để hoàn tất dịch vụ: đơn vị vận chuyển (để giao hàng), cổng thanh toán hoặc ngân hàng (để xác nhận thanh toán), nhà cung cấp email và hạ tầng lưu trữ, hoặc khi cơ quan nhà nước có thẩm quyền yêu cầu theo quy định pháp luật."}]],"$undefined"]}],["$","section","Đăng nhập bằng Google",{"children":[["$","h2",null,{"className":"text-xl font-semibold","children":[4,". ","Đăng nhập bằng Google"]}],[["$","p","Khi bạn chọn đăng nhập bằng Google, chúng tôi chỉ sử dụng họ tên và địa chỉ email để tạo hoặc đăng nhập tài khoản. Chúng tôi không truy cập danh bạ, Drive, lịch hay dữ liệu Google khác của bạn.",{"className":"mt-3 leading-relaxed","children":"Khi bạn chọn đăng nhập bằng Google, chúng tôi chỉ sử dụng họ tên và địa chỉ email để tạo hoặc đăng nhập tài khoản. Chúng tôi không truy cập danh bạ, Drive, lịch hay dữ liệu Google khác của bạn."}]],"$undefined"]}],"$L10","$L11","$L12","$L13"]}]
